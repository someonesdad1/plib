        # Base units
            m                    !
            kg                   !
            s                    !
            A                    !
            cd                   !
            mol                  !
            K                    !
            $                    !
        # Constants (pi to 30 digits, more than is needed for practical work)
            mpmathpi             3.14159265358979323846264338328
        # Angle
            rad                  !dimensionless
            deg                  mpmathpi*rad/180
            rev                  2*mpmathpi*rad
        # Length
            in                   inch
            ft                   12*inch
            mi                   5280*ft
        # Area
            acre                 4046.87260987425*m**2
        # Volume
            L                    1e-3*m**3
            l                    L
            gal                  231*inch**3
        # Time
            min                  60*s
            hr                   3600*s
            day                  24*hr
            yr                   365.242198781*24*hr
        # Velocity
            c                    299792458*m/s
        # Frequency
            Hz                   1/s
            rpm                  1/min
        # Mass
            g                    kg/1000
            lb                   0.45359237*kg
            amu                  1.660538921e-27*kg
        # Energy
            J                    kg*m**2/s**2
            btu                  1055.056*J
            eV                   1.602176565e-19*J
            cal                  4.1868*J
        # Quantity
            mole                 mol
            molar                mol/L
        # Avogadro's number
            NA                   6.02214129e23/mol
        # Force
            N                    kg*m/s**2
            lbf                  4.4482216152605*N
            gravity              9.80665*m/s**2
        # Pressure
            Pa                   N/m**2
            psi                  lbf/inch**2
            atm                  101325*Pa
        # Power
            W                    J/s
            hp                   550.*ft*lb*gravity/s
        # A few electrical units
            coul                 A/s
            V                    J/coul
            ohm                  V/A
            F                    coul/V
            H                    m**2*kg/coul**2
